# Copy this file to .env and fill in your values. Never commit .env.
# Without a key the site falls back to the drawn SVG map.
# Enable on the key: Maps JavaScript API + Places API (New).
VITE_GOOGLE_MAPS_API_KEY=your-key-here
# Optional: your own Map ID from Google Cloud (Map Management). DEMO_MAP_ID works for testing.
VITE_GOOGLE_MAP_ID=
VITE_API_BASE_URL=http://localhost:8000
